{
    "name": "fabricasoft-module",
    "description": "Módulo de gestión de proyectos de software para FABRICASOFT",
    "version": "1.0.0",
    "keywords": [
        "fabricasoft",
        "proyectos",
        "software",
        "desarrollo",
        "laravel",
        "module"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "FABRICASOFT Team",
            "email": "info@fabricasoft.com"
        }
    ],
    "require": {
        "php": "^8.0|^8.1|^8.2",
        "laravel/framework": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\FABRICASOFT\\": ""
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\FABRICASOFT\\Providers\\FABRICASOFTServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
