            // Log de los datos del formulario
            console.log('Datos del formulario de edición:');
            for (let [key, value] of formData.entries()) {
                console.log(key + ': ' + value);
            }
            
            // Verificar CSRF token
            const csrfToken = document.querySelector('meta[name="csrf-token"]');
            if (!csrfToken) {
                console.error('CSRF token no encontrado');
                alert('Error: Token CSRF no encontrado');
                return;
            }
            
            console.log('Enviando formulario de edición a:', this.action);
            
            fetch(this.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-CSRF-TOKEN': csrfToken.getAttribute('content'),
                },
            }).then(response => {
                console.log('Respuesta recibida:', response.status, response.statusText);
                return response.json();
            }).then(data => {
                console.log('Datos de respuesta:', data);
                
                if (data.success) {
                    alert('Información actualizada exitosamente.');
                    
                    // Cerrar modal
                    const modal = document.getElementById('modalEditarInformacion');
                    if (modal) {
                        const bootstrapModal = bootstrap.Modal.getInstance(modal);
                        if (bootstrapModal) {
                            bootstrapModal.hide();
                        }
                    }
                    
                    // Recargar página
                    location.reload();
                } else {
                    alert('Error al actualizar información: ' + (data.message || 'Error desconocido'));
                }
            }).catch(error => {
                console.error('Error en fetch:', error);
                alert('Error al actualizar información: ' + error.message);
            });
        });
    } else {
        console.error('Formulario de editar información NO encontrado');
    }
    
    // Función de debug para verificar el estado
    window.debugButtons = function() {
        console.log('=== DEBUG BOTONES ===');
        console.log('CSRF Token:', document.querySelector('meta[name="csrf-token"]')?.getAttribute('content'));
        console.log('Modal Agregar:', document.getElementById('modalAgregarInformacion'));
        console.log('Modal Editar:', document.getElementById('modalEditarInformacion'));
        console.log('Form Agregar:', document.getElementById('formAgregarInformacion'));
        console.log('Form Editar:', document.getElementById('formEditarInformacion'));
        console.log('Bootstrap disponible:', typeof bootstrap !== 'undefined');
        
        // Verificar botones
        const botonesEditar = document.querySelectorAll('button[onclick*="editarInformacionFase"]');
        const botonesEliminar = document.querySelectorAll('button[onclick*="eliminarInformacionFase"]');
        const botonesAgregar = document.querySelectorAll('button[onclick*="agregarInformacionFase"]');
        
        console.log('Botones Editar encontrados:', botonesEditar.length);
        console.log('Botones Eliminar encontrados:', botonesEliminar.length);
        console.log('Botones Agregar encontrados:', botonesAgregar.length);
        
        return {
            csrf: document.querySelector('meta[name="csrf-token"]')?.getAttribute('content'),
            modals: {
                agregar: !!document.getElementById('modalAgregarInformacion'),
                editar: !!document.getElementById('modalEditarInformacion')
            },
            forms: {
                agregar: !!document.getElementById('formAgregarInformacion'),
                editar: !!document.getElementById('formEditarInformacion')
            },
            bootstrap: typeof bootstrap !== 'undefined',
            botones: {
                editar: botonesEditar.length,
                eliminar: botonesEliminar.length,
                agregar: botonesAgregar.length
            }
        };
    };
    
});
</script>

@push('styles')
